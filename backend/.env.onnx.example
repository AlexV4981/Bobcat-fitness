# Paths are relative to backend/; absolute paths also work.
# COCO-17 RTMPose: input [1,3,256,192], SimCC outputs [1,17,384] and [1,17,512].
BOBCAT_POSE_ONNX=models/rtmpose.onnx
# Metric Depth Anything V2: input [1,3,518,518], output meters, NOT relative depth.
BOBCAT_DEPTH_ONNX=models/depth-anything-v2-metric.onnx
# Optional: measured camera intrinsics keyed by camera ID. Required for 3D/counting.
# BOBCAT_CAMERA_CALIBRATIONS=camera-calibrations.json

# CPU execution engine: onnxruntime is faster in the documented local benchmark.
# Use opencv to compare the original OpenCV DNN execution path.
BOBCAT_ONNX_RUNTIME=onnxruntime
BOBCAT_ONNX_THREADS=6
