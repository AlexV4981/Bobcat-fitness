# Bobcat Fitness uses two env files. Neither is committed (see .gitignore).
#
# frontend/.env.local  (read by Vite; everything here ends up in the browser,
#                       so never put API keys in this file)
#   VITE_SUPABASE_URL=https://your-project.supabase.co
#   VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
#   VITE_AUTH_EMAIL_DOMAIN=yourdomain.com
#
# backend/.env.local   (read by FastAPI; stays on the server)
#   DIETING_KEY=your-gemini-key        # AI Diet page
#   WORKOUT_KEY=your-gemini-key        # AI Workout page
#   GEMINI_MODEL=gemini-3.8-flash      # optional, this is the default
